# TengaSale Environment Variables
# Copy this file to .env and fill in the values.

# Django
SECRET_KEY=changeme-use-a-long-random-string
# Set DEBUG=True for local development. Accepts: True, true, 1, yes
# With DEBUG=True, static files are served directly from source (no collectstatic needed).
# With DEBUG=False (production), whitenoise uses CompressedManifestStaticFilesStorage
# and requires 'python manage.py collectstatic' to have been run.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Support
TENGASALE_WHATSAPP_NUMBER=+265883596135

# ── Payment Providers ──────────────────────────────────────────────────────────
# Set MOCK_PAYMENTS=false and PAYMENTS_MODE=live when real credentials are ready
MOCK_PAYMENTS=true
PAYMENTS_MODE=sandbox

# ── PayChangu (Primary Mobile Money Gateway — Airtel Money & TNM Mpamba) ──────
# Get keys from https://paychangu.com/dashboard/settings/api
PAYCHANGU_PUBLIC_KEY=
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_API_BASE=https://api.paychangu.com
PAYCHANGU_ENVIRONMENT=sandbox
PAYCHANGU_DEFAULT_CURRENCY=MWK
PAYCHANGU_WEBHOOK_DEBUG=false

# Operator ref_id overrides (optional — auto-resolved from PayChangu API if blank)
PAYCHANGU_AIRTEL_REF_ID=
PAYCHANGU_TNM_REF_ID=

# Callback URL: where PayChangu sends payment confirmations (incoming payments)
# Must be publicly accessible (HTTPS in production)
PAYCHANGU_CALLBACK_URL=https://your-domain.onrender.com/pay/webhooks/paychangu/

# Webhook URL: same as callback for PayChangu
PAYCHANGU_WEBHOOK_URL=https://your-domain.onrender.com/pay/webhooks/paychangu/

# ── Safety Flags — must be explicitly enabled for real money movement ──────────
# WARNING: Only set to 'true' in production with valid API keys
PAYMENTS_ALLOW_LIVE_CHARGES=false
PAYOUTS_ALLOW_LIVE_DISBURSEMENTS=false

# Optional: pre-set operator ref_ids to avoid API lookups on every payment
# Find these from GET https://api.paychangu.com/mobile-money
PAYCHANGU_AIRTEL_REF_ID=
PAYCHANGU_TNM_REF_ID=

# Legacy direct provider credentials (not needed if using PayChangu MoMo)
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
TNM_MPAMBA_API_KEY=
PAYTRIGGER_API_KEY=

# Direct Airtel Money Malawi API (UAT/live)
# Put real UAT values in Render/local .env only. Do not commit secrets.
AIRTEL_ENVIRONMENT=staging
AIRTEL_ENV=staging
AIRTEL_PRODUCTION_ENABLED=false
AIRTEL_COLLECTIONS_ENABLED=false
AIRTEL_DRY_RUN=true
AIRTEL_TEST_MAX_AMOUNT=1000
AIRTEL_TEST_MIN_AMOUNT=100
AIRTEL_ALLOWED_TEST_MSISDNS=
AIRTEL_BASE_URL=https://openapiuat.airtel.mw
AIRTEL_COUNTRY=MW
AIRTEL_CURRENCY=MWK
AIRTEL_MERCHANT_CODE=
AIRTEL_PRIVATE_KEY=
AIRTEL_CALLBACK_SECRET=
AIRTEL_CALLBACK_URL=https://tengasale-api.onrender.com/api/payments/airtel/callback/
AIRTEL_CALLBACK_AUTH_ENABLED=true
# Backward-compatible alias for AIRTEL_PRIVATE_KEY; leave empty for new setups.
AIRTEL_CALLBACK_HASH_KEY=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_AUTH_TOKEN=
AIRTEL_PIN=
AIRTEL_MESSAGE_SIGNING_ENABLED=False
AIRTEL_SIGNATURE_SECRET=
AIRTEL_KEY=
AIRTEL_COLLECTION_PATH=/merchant/v1/payments/
AIRTEL_ENQUIRY_PATH_TEMPLATE=/standard/v1/payments/{reference}
AIRTEL_TOKEN_PATH=/auth/oauth2/token
AIRTEL_DISBURSEMENT_PATH=/standard/v3/disbursements
AIRTEL_CALLBACK_MAX_BYTES=65536
AIRTEL_REQUEST_TIMEOUT_SECONDS=30
AIRTEL_CONNECT_TIMEOUT=5
AIRTEL_READ_TIMEOUT=20
AIRTEL_SIMULATION_SECRET=

# Integration Flags (all off by default — use mock mode)
MOCK_DEVICE_LOCKING=true
ENABLE_KNOX=false
ENABLE_NUOVOPAY=false
ENABLE_UPYA=false
ENABLE_PAYTRIGGER=false
ENABLE_PAYCHANGU=false

# Legacy device lock providers
TRUSTONIC_API_KEY=
TRUSTONIC_API_URL=
UPYA_API_KEY=
UPYA_API_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_URL=

# IMEI Verification (DHRU / alpha.imeicheck.com)
IMEI_CHECK_ENABLED=True
IMEI_CHECK_STRICT_MODE=True
IMEI_CHECK_AUTO_VERIFY=True
IMEI_CHECK_USERNAME=your_username
IMEI_CHECK_API_KEY=your_api_key
IMEI_CHECK_ENDPOINT_BASE=https://dhru.checkimei.com
IMEI_CHECK_ALPHA_ENDPOINT_BASE=https://alpha.imeicheck.com
IMEI_CHECK_SERVICE_ID=
IMEI_CHECK_TIMEOUT_SECONDS=20

# ── Device Lock Integration Layer ──────────────────────────────────────────────
# Master switch — set True when a real provider is available.
DEVICE_LOCK_ENABLED=False
# Active provider: mock | samsung_knox | trustonic | paytrigger | none
DEVICE_LOCK_PROVIDER=mock
# Strict mode: lock failure blocks workflow step when True
DEVICE_LOCK_STRICT_MODE=False
# Auto lifecycle hooks (enroll on contract creation, lock/unlock on repayment events)
DEVICE_LOCK_AUTO_ENROLL=False
DEVICE_LOCK_AUTO_LOCK=False
DEVICE_LOCK_AUTO_UNLOCK=False
# Webhook verification secret (leave blank to skip signature check)
DEVICE_LOCK_WEBHOOK_SECRET=
# Provider API credentials — fill in when real provider credentials are issued
DEVICE_LOCK_API_BASE_URL=
DEVICE_LOCK_API_KEY=
DEVICE_LOCK_CLIENT_ID=
DEVICE_LOCK_CLIENT_SECRET=
DEVICE_LOCK_TIMEOUT_SECONDS=20

# ── Twilio SMS / WhatsApp ──────────────────────────────────────────────────────
# Used for payment receipts, deposit reminders, contract activation notifications
# Get credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender phone number (Twilio number in E.164 format, e.g. +1234567890)
TWILIO_PHONE_NUMBER=
# WhatsApp sender (Twilio sandbox: whatsapp:+14155238886 or your approved number)
TWILIO_WHATSAPP_NUMBER=

# ── SendGrid Email ─────────────────────────────────────────────────────────────
# Used for transactional emails (receipts, contract activation, notifications)
# Get API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@tengasale.com
SENDGRID_FROM_EMAIL=TengaSale <noreply@tengasale.com>

# ── KYC Provider ───────────────────────────────────────────────────────────────
# Set KYC_PROVIDER to: manual (default) | didit | metamap
# If provider credentials are missing, the system falls back to manual KYC.
KYC_PROVIDER=manual

# ── Didit KYC (identity verification) ─────────────────────────────────────────
# Get credentials from https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_URL=
DIDIT_CALLBACK_URL=
DIDIT_ALLOW_UNSIGNED_WEBHOOKS=False
REQUIRE_DIDIT_KYC_BEFORE_APPROVAL=False
DIDIT_SEND_EXPECTED_DETAILS=False

# ── MetaMap / Mati KYC (alternative provider) ─────────────────────────────────
# Get credentials from https://dashboard.metamap.com
METAMAP_CLIENT_ID=
METAMAP_CLIENT_SECRET=
METAMAP_FLOW_ID=
METAMAP_WEBHOOK_SECRET=
METAMAP_CALLBACK_URL=

# ── TengaSale Public URLs (for payment links in emails/SMS/webhooks) ───────────
# Set to your production URL (e.g. https://tengasale.onrender.com)
TENGASALE_PUBLIC_BASE_URL=https://your-domain.onrender.com
TENGASALE_PAYMENT_BASE_URL=https://your-domain.onrender.com

# ── WhatsApp / Messaging (Contract PDF Delivery) ────────────────────────────────
# Master switches
MESSAGING_ENABLED=True
WHATSAPP_DELIVERY_ENABLED=True
# Provider: mock (default, no real sends) | twilio | meta_whatsapp
WHATSAPP_PROVIDER=mock
# Hours after contract completion to deliver the completed PDF via WhatsApp
WHATSAPP_SEND_CONTRACT_AFTER_HOURS=24
# Twilio WhatsApp credentials (WHATSAPP_API_KEY = Account SID, WHATSAPP_API_SECRET = Auth Token)
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
# Meta/Facebook WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FROM_NUMBER=
WHATSAPP_TIMEOUT_SECONDS=20
# PDF public URL mode: set True + CONTRACT_PDF_BASE_URL for real WhatsApp sends
# (WhatsApp requires a public document URL; use False for mock/local testing)
CONTRACT_PDF_PUBLIC_URL_MODE=False
CONTRACT_PDF_BASE_URL=https://your-domain.onrender.com
